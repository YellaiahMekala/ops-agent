{
  "ifResourceExists": "SKIP",
  "roles": {
    "realm": [
      {
        "name": "OPS_ALERT_SENDER",
        "description": "ops-agent: may POST /alerts (the Alertmanager side). Cannot read runs."
      },
      {
        "name": "OPS_RUN_VIEWER",
        "description": "ops-agent: may read /api/v1/runs of its own tenant. Cannot raise alerts."
      }
    ]
  },
  "clients": [
    {
      "clientId": "ops-alertmanager-tenant-a",
      "name": "Alertmanager webhook sender for ops-agent (tenant-a, synthetic)",
      "description": "Confidential client, client-credentials only. No secret is stored in this file: Keycloak generates one at import; read it with the admin API (see deploy/keycloak/import-ops-agent.sh). tenant_id is hard-coded, so the caller cannot choose its tenant.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "audience ops-agent",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "ops-agent", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles", "multivalued": "true", "jsonType.label": "String",
            "access.token.claim": "true", "id.token.claim": "false"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id", "claim.value": "tenant-a", "jsonType.label": "String",
            "access.token.claim": "true", "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ops-viewer-tenant-a",
      "name": "ops-agent run viewer (tenant-a, synthetic)",
      "description": "Confidential client-credentials client holding OPS_RUN_VIEWER only. Secret generated at import.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "audience ops-agent",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "ops-agent", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles", "multivalued": "true", "jsonType.label": "String",
            "access.token.claim": "true", "id.token.claim": "false"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id", "claim.value": "tenant-a", "jsonType.label": "String",
            "access.token.claim": "true", "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ops-viewer-tenant-b",
      "name": "ops-agent run viewer (tenant-b, synthetic)",
      "description": "Same as ops-viewer-tenant-a but tenant-b; used to prove cross-tenant reads are 404.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "audience ops-agent",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "ops-agent", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles", "multivalued": "true", "jsonType.label": "String",
            "access.token.claim": "true", "id.token.claim": "false"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id", "claim.value": "tenant-b", "jsonType.label": "String",
            "access.token.claim": "true", "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-ops-alertmanager-tenant-a",
      "enabled": true,
      "serviceAccountClientId": "ops-alertmanager-tenant-a",
      "realmRoles": ["OPS_ALERT_SENDER"]
    },
    {
      "username": "service-account-ops-viewer-tenant-a",
      "enabled": true,
      "serviceAccountClientId": "ops-viewer-tenant-a",
      "realmRoles": ["OPS_RUN_VIEWER"]
    },
    {
      "username": "service-account-ops-viewer-tenant-b",
      "enabled": true,
      "serviceAccountClientId": "ops-viewer-tenant-b",
      "realmRoles": ["OPS_RUN_VIEWER"]
    }
  ]
}
